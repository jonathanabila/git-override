#!/usr/bin/env bash
#
# git-local-override - Utility for managing local file overrides
#
# This tool helps manage local modifications to tracked files.
# Configuration is stored in .local-overrides.yaml in your repository.
#
# The main functionality is provided by git hooks (installed separately).
# This CLI provides utility commands for managing override files.
#
# WHY CLI IS SEPARATE FROM HOOKS:
# The CLI is optional - hooks work independently. This allows users who only
# need basic functionality to skip CLI installation entirely. The CLI adds
# convenience commands (add, remove, list, status) but isn't required.
#
# NOTE ON SHARED RESOLVER LOADING:
# The CLI stays standalone from hooks by sourcing a shared resolver module from
# the repo checkout during development or from its installed support directory.
#
set -euo pipefail

# Colors for output (if terminal supports it)
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

#------------------------------------------------------------------------------
# Utility Functions
#------------------------------------------------------------------------------

die() {
    echo -e "${RED}Error:${NC} $*" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}Warning:${NC} $*" >&2
}

info() {
    echo -e "${BLUE}Info:${NC} $*"
}

success() {
    echo -e "${GREEN}Success:${NC} $*"
}

local_override_trace() {
    if local_override_trace_enabled; then
        echo -e "${BLUE}Trace:${NC} $*"
    fi
}

log_step_duration() {
    local label="$1"
    local start_ms="$2"
    local elapsed_ms

    elapsed_ms="$(resolver_elapsed_milliseconds "$start_ms")"
    info "$label in ${elapsed_ms}ms"
}

display_relative_path() {
    local path="$1"

    if [[ "$path" == */* ]]; then
        printf '%s\n' "$path"
    else
        printf './%s\n' "$path"
    fi
}

# Get the git hooks directory as an absolute path.
# Uses `git rev-parse --git-path hooks` so linked worktrees resolve to the
# shared hooks directory and core.hooksPath is honored, matching git's own
# hook resolution.
get_hooks_dir() {
    local repo_root="$1"
    local hooks_dir

    hooks_dir="$(git -C "$repo_root" rev-parse --git-path hooks 2>/dev/null || echo "")"
    [[ -n "$hooks_dir" ]] || die "Unable to resolve git hooks directory"

    if [[ "$hooks_dir" != /* ]]; then
        hooks_dir="$repo_root/$hooks_dir"
    fi

    echo "$hooks_dir"
}

CONFIG_FILE_NAME=".local-overrides.yaml"
VERSION_FILE_NAME="VERSION"
PRE_COMMIT_FRAMEWORK_MARKER='# File generated by pre-commit: https://pre-commit.com'

# Shared status/doctor check helpers. Both commands consume these so their
# checks cannot drift (they had, before plan 029). Each returns multi-valued
# state as a single printed word (Bash 3.2 — no associative arrays/namerefs).

# Prints one of: direct | precommit | missing.
detect_hooks_installed() {
    local checkout_root="$1"
    local hooks_dir="$2"
    local via_precommit=false
    local hook_type=""

    for hook_type in post-checkout pre-commit post-commit; do
        local hook_file="$hooks_dir/$hook_type"

        if [[ ! -f "$hook_file" ]]; then
            printf 'missing\n'
            return 0
        fi

        # Direct install: hook script references local-override
        if grep -q "local-override" "$hook_file" 2>/dev/null; then
            continue
        fi

        # Pre-commit framework install: generic shim plus a matching
        # local-override hook id in the repo's pre-commit config
        if grep -qF "$PRE_COMMIT_FRAMEWORK_MARKER" "$hook_file" 2>/dev/null \
            && grep -q "local-override-$hook_type" "$checkout_root/.pre-commit-config.yaml" 2>/dev/null; then
            via_precommit=true
            continue
        fi

        printf 'missing\n'
        return 0
    done

    if [[ "$via_precommit" == true ]]; then
        printf 'precommit\n'
    else
        printf 'direct\n'
    fi
}

# Prints one of: process | smudge-clean | none.
get_filter_driver_mode() {
    local checkout_root="$1"
    local filter_smudge
    local filter_clean
    local filter_process

    filter_smudge="$(git -C "$checkout_root" config --local filter.local-override.smudge 2>/dev/null || echo "")"
    filter_clean="$(git -C "$checkout_root" config --local filter.local-override.clean 2>/dev/null || echo "")"
    filter_process="$(git -C "$checkout_root" config --local filter.local-override.process 2>/dev/null || echo "")"

    if [[ -n "$filter_process" ]]; then
        printf 'process\n'
    elif [[ -n "$filter_smudge" && -n "$filter_clean" ]]; then
        printf 'smudge-clean\n'
    else
        printf 'none\n'
    fi
}

# Count of managed `filter=local-override` lines in an attributes file; prints 0
# when the file is missing or has no matches.
count_managed_attribute_lines() {
    local attributes_file="$1"
    local filter_count=0

    # grep -c prints "0" and exits non-zero when there are no matches; piping
    # that through `|| echo 0` would append a second line and make the value a
    # two-line string that breaks arithmetic. Default on failure instead.
    if [[ -f "$attributes_file" ]]; then
        filter_count=$(grep -c "filter=local-override" "$attributes_file" 2>/dev/null) || filter_count=0
    fi

    printf '%s\n' "$filter_count"
}

# Count of effective `target|override` entries in the resolved config.
count_effective_targets() {
    local repo_root="$1"
    read_config "$repo_root" | grep -c '|' || true
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_SUPPORT_DIR_DEFAULT="${XDG_DATA_HOME:-$HOME/.local/share}/git-local-override"
SHARED_RESOLVER_PATH=""

get_version() {
    local version_path

    version_path="$(locate_support_file "$VERSION_FILE_NAME" 2>/dev/null || true)"
    if [[ -n "$version_path" && -f "$version_path" ]]; then
        tr -d '\r' < "$version_path"
        return 0
    fi

    printf '%s\n' "unknown"
}

if [[ -f "$SCRIPT_DIR/../shared/local-override-resolver.sh" ]]; then
    SHARED_RESOLVER_PATH="$SCRIPT_DIR/../shared/local-override-resolver.sh"
elif [[ -f "$CLI_SUPPORT_DIR_DEFAULT/local-override-resolver.sh" ]]; then
    SHARED_RESOLVER_PATH="$CLI_SUPPORT_DIR_DEFAULT/local-override-resolver.sh"
else
    die "Unable to locate local-override-resolver.sh"
fi

# shellcheck source=../shared/local-override-resolver.sh
source "$SHARED_RESOLVER_PATH"

# Backstop cleanup: the per-command RETURN traps clear the discovery cache
# promptly within a run, but RETURN traps do not fire on process exit. Register
# a single EXIT trap so the mktemp'd cache file is removed even on die()/exit 1
# paths. clear_config_files_cache is idempotent and no-ops when no cache exists.
trap 'clear_config_files_cache 2>/dev/null || true' EXIT

# Populate the discovery cache for a READ-ONLY command via stamp-gated hot
# discovery, mirroring the post-checkout hot path (plan 043): one non-ignored
# walk plus a free re-check of the gitignored configs recorded in the config
# stamp, then fall back to a full walk only on drift. Args: checkout_root
# (where the stamp lives) and resolution_root (what the config set resolves
# against; equals checkout_root outside fallback worktrees).
#
# The stamp is compared against the hot cache, so a matching stamp means "no
# config drift is visible without an ignored-tree walk" and the hot cache is
# trusted. A mismatch — or no stamp yet (fresh clone before any
# sync-filters/post-checkout slow path) — recaches full so a directly-ignored
# config the hot walk cannot see is still found. Read-only commands never write
# the stamp: sync-filters and the post-checkout slow path stay the only writing
# authorities, so a stale-but-present stamp can only cost a fallback walk, never
# hide a config from a mutating command. Callers keep their own
# `trap 'clear_config_files_cache' RETURN`; a RETURN trap set here would fire
# when this helper returns and clear the cache before the caller uses it.
cache_config_files_readonly() {
    local checkout_root="$1"
    local resolution_root="$2"

    # A read-only command that delegates to another (status -> list) has already
    # populated and stamp-validated the cache; reuse it rather than re-deriving
    # hot/full, which would thrash the mode key (an outer full cache vs an inner
    # hot request forces two needless re-scans).
    if config_files_cached_for "$resolution_root"; then
        return 0
    fi

    discover_config_files_hot_then_full "$checkout_root" "$resolution_root"
}

cmd_version() {
    get_version
}

# Convert path to local override path using specified pattern
# Used by the 'add' command to generate default override filenames
# e.g., get_local_path "AGENTS.md" ".override" -> AGENTS.override.md
get_local_path() {
    local path="$1"
    local pattern="${2:-.local}"
    local dir basename ext

    # Remove leading dot from pattern for insertion
    local pattern_infix="${pattern#.}"

    dir="$(dirname "$path")"
    basename="$(basename "$path")"

    if [[ "$basename" == *.* ]]; then
        ext="${basename##*.}"
        basename="${basename%.*}"
        if [[ "$dir" == "." ]]; then
            echo "${basename}.${pattern_infix}.${ext}"
        else
            echo "${dir}/${basename}.${pattern_infix}.${ext}"
        fi
    else
        if [[ "$dir" == "." ]]; then
            echo "${basename}.${pattern_infix}"
        else
            echo "${dir}/${basename}.${pattern_infix}"
        fi
    fi
}

# Normalize a path to be relative to repo root
normalize_path() {
    local path="$1"
    local repo_root
    repo_root="$(get_repo_root)" || die "Not in a git repository"

    # If path is absolute, make it relative to repo root
    if [[ "$path" == /* ]]; then
        path="${path#"$repo_root"/}"
    fi

    # Remove leading ./ if present
    path="${path#./}"

    echo "$path"
}

make_path_relative_to_dir() {
    local path="$1"
    local dir="$2"

    if [[ "$dir" == "." || -z "$dir" ]]; then
        printf '%s\n' "$path"
        return 0
    fi

    if [[ "$path" == "$dir"/* ]]; then
        printf '%s\n' "${path#"$dir/"}"
        return 0
    fi

    if [[ "$path" == "$dir" ]]; then
        printf '.\n'
        return 0
    fi

    return 1
}

#------------------------------------------------------------------------------
# Commands
#------------------------------------------------------------------------------

cmd_add() {
    local path="${1:-}"

    if [[ -z "$path" ]]; then
        die "Usage: git-local-override add <path>"
    fi

    local repo_root
    repo_root="$(get_repo_root)" || die "Not in a git repository"
    path="$(normalize_path "$path")"

    local full_path="$repo_root/$path"

    # Check if file exists
    if [[ ! -f "$full_path" ]]; then
        die "File does not exist: $path"
    fi

    # All config reads below happen before any file writes, and add only ever
    # writes override/target files (never a config file), so caching the whole
    # command is safe.
    cache_config_files "$repo_root"
    trap 'clear_config_files_cache' RETURN

    # Check if file is already in config
    local override_path
    local config_path=""
    local pattern=""
    local config_dir=""
    local in_config=false

    if override_path=$(get_override_for_target "$path" "$repo_root"); then
        in_config=true
        config_path="$(get_config_for_target "$path" "$repo_root")"
    else
        if config_path=$(find_nearest_config_for_path "$repo_root" "$path"); then
            pattern="$(get_effective_pattern_for_config "$repo_root" "$config_path")"
        else
            config_path="$CONFIG_FILE_NAME"
            pattern=".local"
        fi

        [[ -n "$pattern" ]] || pattern=".local"
        config_dir="$(config_dir_for_path "$config_path")"
        local relative_target_path=""
        if ! relative_target_path="$(make_path_relative_to_dir "$path" "$config_dir")"; then
            relative_target_path="$path"
        fi
        override_path="$(get_local_path "$relative_target_path" "$pattern")"
        override_path="$(normalize_config_path "$config_dir" "$override_path")"
    fi

    local full_override_path="$repo_root/$override_path"

    # Refuse symlinked target paths: cp follows symlinks, so a symlinked
    # target would let a write escape the repo. Override paths are read-side:
    # a user-created symlink is allowed behind the local opt-in
    # (local-override.followSymlinkedOverrides).
    if ! path_is_symlink_safe "$repo_root" "$path"; then
        die "refusing symlinked path: $path"
    fi
    if ! override_path_is_symlink_safe "$repo_root" "$override_path" "$repo_root"; then
        die "refusing symlinked path: $override_path"
    fi

    # Create the override file if it doesn't exist
    if [[ ! -f "$full_override_path" ]]; then
        # Ensure parent directory exists
        mkdir -p "$(dirname "$full_override_path")"
        cp "$full_path" "$full_override_path"
        success "Created override file: $override_path"
    else
        info "Override file already exists: $override_path"
    fi

    if [[ "$in_config" == true ]]; then
        # Apply the override
        cp "$full_override_path" "$full_path"
        success "Override active for: $path"
        echo "  Edit your override file: $override_path"
    else
        local config_label="$config_path"
        info "To enable this override, add to $config_label:"
        echo ""
        if [[ -z "$config_dir" ]]; then
            config_dir="$(config_dir_for_path "$config_path")"
        fi
        local display_override="$override_path"
        local display_target="$path"
        if display_override=$(make_path_relative_to_dir "$override_path" "$config_dir"); then
            :
        else
            display_override="$override_path"
        fi
        if display_target=$(make_path_relative_to_dir "$path" "$config_dir"); then
            :
        else
            display_target="$path"
        fi
        echo "  - override: $display_override"
        echo "    replaces:"
        echo "      - $display_target"
        echo ""
    fi
}

cmd_remove() {
    local path="${1:-}"
    local delete_file=false

    if [[ "$path" == "--delete" || "$path" == "-d" ]]; then
        delete_file=true
        path="${2:-}"
    fi

    if [[ -z "$path" ]]; then
        die "Usage: git-local-override remove [-d|--delete] <path>"
    fi

    local repo_root
    repo_root="$(get_repo_root)" || die "Not in a git repository"
    path="$(normalize_path "$path")"

    # Intervening writes touch target/override files, never config files, so
    # the discovery cache stays valid across the whole command.
    cache_config_files "$repo_root"
    trap 'clear_config_files_cache' RETURN

    # Get override path from config
    local override_path
    if ! override_path=$(get_override_for_target "$path" "$repo_root"); then
        die "'$path' is not configured in any $CONFIG_FILE_NAME"
    fi

    local full_path="$repo_root/$path"
    local full_override_path="$repo_root/$override_path"

    # Restore original content from git
    if git -C "$repo_root" ls-files --error-unmatch -- "$path" &>/dev/null; then
        git -C "$repo_root" checkout HEAD -- "$path" 2>/dev/null || true
        info "Restored original content: $path"
    fi

    # Optionally delete the override file
    if [[ "$delete_file" == true && -f "$full_override_path" ]]; then
        rm "$full_override_path"
        info "Deleted override file: $override_path"
    elif [[ -f "$full_override_path" ]]; then
        info "Override file preserved: $override_path"
        echo "  Use -d/--delete to also remove the override file"
    fi

    local config_path=""
    if config_path=$(get_config_for_target "$path" "$repo_root"); then
        info "Remember to remove '$path' from the 'replaces:' list in $config_path"
    fi
    success "Override removed for: $path"
}

cmd_list() {
    local checkout_root
    local repo_root
    checkout_root="$(get_repo_root)" || die "Not in a git repository"
    repo_root="$(get_resolution_root "$checkout_root")"

    cache_config_files_readonly "$checkout_root" "$repo_root"
    trap 'clear_config_files_cache' RETURN

    if ! has_any_config "$repo_root"; then
        echo "No $CONFIG_FILE_NAME found in repository"
        echo ""
        echo "Create one with: git-local-override init-config"
        return 0
    fi

    # Validate config
    if ! validate_config "$repo_root"; then
        return 1
    fi

    echo "Configured overrides:"
    echo ""

    local total_overrides=0
    local active_overrides=0

    # Group by override file
    local override_file
    while IFS= read -r override_file || [[ -n "$override_file" ]]; do
        [[ -z "$override_file" ]] && continue

        local status=""
        local owner_config=""
        local symlink_note=""
        local full_override_path="$repo_root/$override_file"
        if [[ -L "$full_override_path" ]]; then
            # Show the state the filters/apply will actually use, not what a
            # link-following -f suggests.
            symlink_note=" (symlink)"
            case "$(classify_symlinked_override "$repo_root" "$override_file")" in
                followed)
                    status="${GREEN}[active]${NC}"
                    ((active_overrides++)) || true
                    ;;
                ignored-optout|tracked-refused)
                    status="${YELLOW}[symlink ignored]${NC}"
                    ;;
                dangling)
                    status="${YELLOW}[no file]${NC}"
                    ;;
            esac
        elif [[ -f "$full_override_path" ]]; then
            status="${GREEN}[active]${NC}"
            ((active_overrides++)) || true
        else
            status="${YELLOW}[no file]${NC}"
        fi

        # Get all targets for this override
        local targets=""
        local target_count=0
        local target
        local first_target=""
        while IFS= read -r target || [[ -n "$target" ]]; do
            [[ -z "$target" ]] && continue
            if [[ -z "$first_target" ]]; then
                first_target="$target"
            fi
            if [[ -n "$targets" ]]; then
                targets="$targets, $target"
            else
                targets="$target"
            fi
            ((target_count++)) || true
        done < <(get_targets_for_override "$repo_root" "$override_file")

        if [[ -n "$first_target" ]]; then
            owner_config="$(get_config_for_target "$first_target" "$repo_root" 2>/dev/null || true)"
        fi
        ((total_overrides += target_count)) || true

        echo -e "  ${BLUE}$override_file${NC} $status$symlink_note"
        [[ -n "$owner_config" ]] && echo "    config: $owner_config"
        echo "    -> $targets"
        echo ""
    done < <(get_override_files "$repo_root")

    echo "Total: $total_overrides target(s), $active_overrides active override file(s)"
}

# Sync .git/info/attributes from config file
# Preserves non-local-override entries, regenerates local-override entries
# Thin wrapper over the resolver's canonical sync_attributes_entries core.
# Resolves config entries when the caller doesn't supply them, then delegates.
sync_attributes() {
    local repo_root="$1"
    local config_entries="${2:-}"

    # Resolve config entries if not provided
    if [[ -z "$config_entries" ]] && has_any_config "$repo_root"; then
        config_entries="$(read_config "$repo_root")"
    fi

    sync_attributes_entries "$repo_root" "$config_entries" \
        || die "Failed to write attributes file"
}

cmd_status() {
    local checkout_root
    local repo_root
    checkout_root="$(get_repo_root)" || die "Not in a git repository"
    repo_root="$(get_resolution_root "$checkout_root")"

    cache_config_files_readonly "$checkout_root" "$repo_root"
    trap 'clear_config_files_cache' RETURN

    echo "Local Override Status"
    echo "====================="
    echo ""
    echo "Repository: $checkout_root"
    if [[ "$repo_root" != "$checkout_root" ]] && has_any_config "$repo_root"; then
        echo "Overrides:  inherited from main worktree ($repo_root)"
    fi
    echo ""

    if has_any_config "$repo_root"; then
        local config_count=0
        local config_path=""
        while IFS= read -r config_path || [[ -n "$config_path" ]]; do
            [[ -n "$config_path" ]] || continue
            ((config_count++)) || true
        done < <(get_cached_config_files "$repo_root")

        echo -e "Configs:    ${GREEN}$config_count discovered${NC}"
    else
        echo -e "Configs:    ${YELLOW}not found${NC}"
        echo ""
        echo "Create config with: git-local-override init-config"
        return 0
    fi

    # Check if hooks are installed (directly or via the pre-commit framework)
    local hooks_dir
    hooks_dir="$(get_hooks_dir "$checkout_root")"

    local hooks_state
    hooks_state="$(detect_hooks_installed "$checkout_root" "$hooks_dir")"

    if [[ "$hooks_state" == precommit ]]; then
        echo -e "Hooks:      ${GREEN}installed (via pre-commit)${NC}"
    elif [[ "$hooks_state" == direct ]]; then
        echo -e "Hooks:      ${GREEN}installed${NC}"
    else
        echo -e "Hooks:      ${YELLOW}not installed${NC}"
        echo ""
        echo "Install hooks with one of:"
        echo "  - pre-commit install --hook-type pre-commit --hook-type post-commit --hook-type post-checkout"
        echo "  - curl -fsSL https://raw.githubusercontent.com/jonathanabila/git-override/main/scripts/install.sh | bash -s -- --cli"
    fi

    # Check filter driver status
    local filter_mode
    filter_mode="$(get_filter_driver_mode "$checkout_root")"

    if [[ "$filter_mode" == none ]]; then
        echo -e "Filter:     ${YELLOW}not installed${NC}"
        echo ""
        echo "Install filter with:"
        echo "  curl -fsSL https://raw.githubusercontent.com/jonathanabila/git-override/main/scripts/install.sh | bash -s -- --cli"
    else
        if [[ "$filter_mode" == process ]]; then
            echo -e "Filter:     ${GREEN}installed (filter.process, experimental)${NC}"
        else
            echo -e "Filter:     ${GREEN}installed${NC}"
        fi

        # Check if .git/info/attributes exists and has entries
        local attributes_file
        attributes_file="$(get_attributes_file_path "$checkout_root")" || die "Unable to resolve git attributes path"
        if [[ -f "$attributes_file" ]]; then
            local filter_count
            filter_count="$(count_managed_attribute_lines "$attributes_file")"
            if [[ "$filter_count" -gt 0 ]]; then
                echo -e "Filtered:   ${GREEN}$filter_count file(s)${NC}"

                # Check if filter and config are in sync
                local config_target_count
                config_target_count="$(count_effective_targets "$repo_root")"

                if [[ "$filter_count" -eq "$config_target_count" ]]; then
                    echo -e "Sync:       ${GREEN}in sync${NC}"
                else
                    echo -e "Sync:       ${YELLOW}out of sync (config: $config_target_count, filtered: $filter_count)${NC}"
                    echo ""
                    echo "Run 'git-local-override sync-filters' to fix"
                fi
            else
                echo -e "Filtered:   ${YELLOW}0 files${NC}"
                echo ""
                echo "Run 'git-local-override sync-filters' to populate"
            fi
        else
            echo -e "Filtered:   ${YELLOW}no attributes file${NC}"
            echo ""
            echo "Run 'git-local-override sync-filters' to create"
        fi
    fi

    echo ""
    # Must stay the final statement: cmd_list's RETURN trap clears the shared
    # config cache, so anything added after this call would run uncached.
    cmd_list
}

apply_to_checkout() {
    local checkout_root="$1"
    local repo_root
    local apply_start_ms
    local step_start_ms
    local trace_step_start_ms
    local config_entries=""
    local configured_count=0
    local active_count=0
    apply_start_ms="$(resolver_now_milliseconds)"

    info "Applying overrides..."

    trace_step_start_ms="$(resolver_now_milliseconds)"
    repo_root="$(get_resolution_root "$checkout_root")"
    if local_override_trace_enabled; then
        local_override_trace "Resolved repo root in $(resolver_elapsed_milliseconds "$trace_step_start_ms")ms: $repo_root"
    fi

    trace_step_start_ms="$(resolver_now_milliseconds)"
    cache_config_files "$repo_root"
    trap 'clear_config_files_cache' RETURN
    if local_override_trace_enabled; then
        local config_file_count
        config_file_count="$(count_list_entries "$(get_cached_config_files "$repo_root")")"
        local_override_trace "Cached $config_file_count config file(s) in $(resolver_elapsed_milliseconds "$trace_step_start_ms")ms"
    fi

    trace_step_start_ms="$(resolver_now_milliseconds)"
    if ! has_any_config "$repo_root"; then
        die "No $CONFIG_FILE_NAME found"
    fi
    if local_override_trace_enabled; then
        local_override_trace "Checked for config files in $(resolver_elapsed_milliseconds "$trace_step_start_ms")ms"
    fi

    step_start_ms="$(resolver_now_milliseconds)"
    info "Validating config..."
    if ! validate_config "$repo_root"; then
        exit 1
    fi
    log_step_duration "Validated config" "$step_start_ms"

    step_start_ms="$(resolver_now_milliseconds)"
    info "Resolving effective override map..."
    config_entries="$(read_config "$repo_root")"

    local entry target override
    local full_target=""
    local full_override=""
    while IFS= read -r entry || [[ -n "$entry" ]]; do
        [[ -z "$entry" ]] && continue

        ((configured_count++)) || true

        target="${entry%%|*}"
        override="${entry#*|}"
        full_target="$checkout_root/$target"
        full_override="$repo_root/$override"

        if [[ -f "$full_override" && -f "$full_target" ]]; then
            ((active_count++)) || true
        fi
    done <<< "$config_entries"
    log_step_duration "Resolved override map" "$step_start_ms"
    info "Configured targets: $configured_count; active overrides: $active_count"

    if [[ "$active_count" -eq 0 ]]; then
        info "No active override files found; syncing attributes only"
    fi

    local count=0
    step_start_ms="$(resolver_now_milliseconds)"
    info "Applying active overrides..."
    while IFS= read -r entry || [[ -n "$entry" ]]; do
        [[ -z "$entry" ]] && continue

        target="${entry%%|*}"
        override="${entry#*|}"

        local apply_target_start_ms
        local copy_start_ms
        local git_add_start_ms
        local copy_ms
        local git_add_ms
        local apply_status

        apply_target_start_ms="$(resolver_now_milliseconds)"
        copy_start_ms="$apply_target_start_ms"
        # The resolver's write-side front door owns the symlink gates and the
        # copy. A refused entry is a benign skip (matching post-checkout and
        # the filters, with the refusal already printed loud), so later
        # entries still apply and sync_attributes below keeps attributes
        # consistent; a missing target/override is the normal inactive case.
        apply_status=0
        apply_override_to_target "$checkout_root" "$repo_root" "$target" "$override" loud \
            || apply_status=$?
        if [[ "$apply_status" -eq 3 ]]; then
            die "Failed to apply $override -> $target"
        elif [[ "$apply_status" -ne 0 ]]; then
            continue
        fi
        copy_ms="$(resolver_elapsed_milliseconds "$copy_start_ms")"
        # Update index via clean filter so git status sees file as clean
        git_add_start_ms="$(resolver_now_milliseconds)"
        git -C "$checkout_root" add -- "$target" 2>/dev/null || true
        git_add_ms="$(resolver_elapsed_milliseconds "$git_add_start_ms")"
        ((count++)) || true

        local display_target
        local display_override
        display_target="$(display_relative_path "$target")"
        display_override="$(display_relative_path "$override")"

        if local_override_trace_enabled; then
            info "Applied $count/$active_count: $display_target <- $display_override"
            local_override_trace "Apply timing for $display_target <- $display_override: cp=${copy_ms}ms, git_add=${git_add_ms}ms, total=$(resolver_elapsed_milliseconds "$apply_target_start_ms")ms"
        else
            echo "  Applied $count/$active_count: $display_target <- $display_override"
        fi
    done <<< "$config_entries"
    log_step_duration "Applied overrides" "$step_start_ms"

    # Sync .git/info/attributes to match config
    step_start_ms="$(resolver_now_milliseconds)"
    info "Syncing attributes..."
    sync_attributes "$checkout_root" "$config_entries"
    log_step_duration "Synced attributes" "$step_start_ms"

    # Register the resolved config set (incl. any newly created gitignored
    # configs) in the config stamp so the post-checkout hot path can trust it —
    # mirrors cmd_sync_filters. Cache here is full-mode, so the stamp captures
    # the complete set. Without this, an apply-registered gitignored config is
    # invisible to the stamp comparison and later edits to it are missed.
    write_config_stamp "$checkout_root" "$repo_root"

    success "Applied $count override(s) in $(resolver_elapsed_milliseconds "$apply_start_ms")ms"
}

# Runs "$per_checkout_fn <root>" in every worktree of the current repo.
# $2 present-participle label ("Applying"); $3 failure verb ("apply");
# $4 success message printf-format taking the count ("Applied overrides in
# %s checkout(s)"). Isolates each checkout in a subshell so one failure is
# tallied without aborting the rest, then dies if any failed.
run_in_each_worktree() {
    local per_checkout_fn="$1"
    local running_label="$2"
    local fail_verb="$3"
    local success_format="$4"

    local start_root
    start_root="$(get_repo_root)" || die "Not in a git repository"

    local line=""
    local wt_root=""
    local ok_count=0
    local failed_count=0

    # NUL-delimited worktree records (via the shared resolver helper) so
    # worktree paths containing newlines parse correctly on git >= 2.36.
    while IFS= read -r -d '' line || [[ -n "$line" ]]; do
        case "$line" in
            worktree\ *) ;;
            *) continue ;;
        esac
        wt_root="${line#worktree }"

        if [[ ! -d "$wt_root" ]]; then
            info "Skipping missing worktree: $wt_root"
            continue
        fi
        if ! git -C "$wt_root" rev-parse --show-toplevel >/dev/null 2>&1; then
            info "Skipping non-checkout entry: $wt_root"
            continue
        fi

        info "=== $running_label in $wt_root ==="
        # Subshell: the per-checkout function may die/exit on failure; the
        # subshell absorbs it so remaining worktrees still run.
        if (cd "$wt_root" && "$per_checkout_fn" "$wt_root"); then
            ((ok_count++)) || true
        else
            ((failed_count++)) || true
        fi
    done < <(list_worktrees_porcelain_nul "$start_root")

    if [[ "$failed_count" -gt 0 ]]; then
        die "$fail_verb failed in $failed_count worktree(s) (succeeded in $ok_count)"
    fi
    # success_format is a trusted constant supplied by the caller.
    # shellcheck disable=SC2059
    success "$(printf "$success_format" "$ok_count")"
}

cmd_apply() {
    local all_worktrees=false
    local arg=""

    for arg in "$@"; do
        case "$arg" in
            --all-worktrees) all_worktrees=true ;;
            *) die "Unknown option for apply: $arg" ;;
        esac
    done

    if [[ "$all_worktrees" == false ]]; then
        local single_root
        single_root="$(get_repo_root)" || die "Not in a git repository"
        apply_to_checkout "$single_root"
        return $?
    fi

    run_in_each_worktree apply_to_checkout "Applying" "apply" "Applied overrides in %s checkout(s)"
}

restore_in_checkout() {
    local checkout_root="$1"
    local repo_root
    repo_root="$(get_resolution_root "$checkout_root")"

    if ! has_any_config "$repo_root"; then
        die "No $CONFIG_FILE_NAME found"
    fi

    cache_config_files "$repo_root"
    trap 'clear_config_files_cache' RETURN

    # Validate config
    if ! validate_config "$repo_root"; then
        exit 1
    fi

    info "Restoring all originals..."

    local count=0
    local entry target override
    while IFS= read -r entry || [[ -n "$entry" ]]; do
        [[ -z "$entry" ]] && continue

        target="${entry%%|*}"
        override="${entry#*|}"

        # Only restore if there's an override file
        if [[ -f "$repo_root/$override" ]]; then
            if git -C "$checkout_root" ls-files --error-unmatch -- "$target" &>/dev/null; then
                if ! path_is_symlink_safe "$checkout_root" "$target"; then
                    die "refusing symlinked path: $target"
                fi
                git -C "$checkout_root" show "HEAD:$target" > "$checkout_root/$target" 2>/dev/null || true
                echo "  Restored: $target"
                ((count++)) || true
            fi
        fi
    done < <(read_config "$repo_root")

    success "Restored $count file(s)"
}

cmd_restore() {
    local all_worktrees=false
    local arg=""

    for arg in "$@"; do
        case "$arg" in
            --all-worktrees) all_worktrees=true ;;
            *) die "Unknown option for restore: $arg" ;;
        esac
    done

    if [[ "$all_worktrees" == false ]]; then
        local single_root
        single_root="$(get_repo_root)" || die "Not in a git repository"
        restore_in_checkout "$single_root"
        return $?
    fi

    run_in_each_worktree restore_in_checkout "Restoring" "restore" "Restored originals in %s checkout(s)"
}

cmd_sync_filters() {
    local checkout_root
    local repo_root
    local common_git_dir
    local expected_smudge
    local expected_clean
    local filter_smudge
    local filter_clean

    checkout_root="$(get_repo_root)" || die "Not in a git repository"
    repo_root="$(get_resolution_root "$checkout_root")"

    # Cache config discovery for the duration of sync-filters and reuse it for
    # the has_any_config check (which otherwise pays a throwaway walk first).
    cache_config_files "$repo_root"
    trap 'clear_config_files_cache' RETURN

    if ! has_any_config "$repo_root"; then
        die "No $CONFIG_FILE_NAME found"
    fi

    info "Validating config..."
    if ! validate_config "$repo_root"; then
        exit 1
    fi

    info "Syncing filter driver configuration..."

    # Configure git filter if missing or legacy relative path. The resolver's
    # configure_filter_driver is the single writer of the driver config. An
    # existing local filter.process opt-in (experimental, plan 019) is
    # preserved — refreshed if its path drifted — instead of being silently
    # reverted to scripts mode with process left dangling in the config.
    common_git_dir="$(get_common_git_dir "$checkout_root")" || die "Unable to resolve git common directory"

    local existing_process
    existing_process="$(git -C "$checkout_root" config --local filter.local-override.process 2>/dev/null || echo "")"
    if [[ -n "$existing_process" ]]; then
        if [[ "$existing_process" != "$common_git_dir/hooks/local-override-filter-process" ]]; then
            info "Configuring filter driver (preserving filter.process opt-in)..."
            configure_filter_driver "$checkout_root" "$common_git_dir/hooks" process \
                || die "Unable to configure filter driver"
            success "Filter driver configured (filter.process)"
        else
            info "Filter driver already configured (filter.process opt-in)"
        fi
    else
        expected_smudge="$common_git_dir/hooks/local-override-filter-smudge %f"
        expected_clean="$common_git_dir/hooks/local-override-filter-clean %f"

        filter_smudge="$(git -C "$checkout_root" config --local filter.local-override.smudge 2>/dev/null || echo "")"
        filter_clean="$(git -C "$checkout_root" config --local filter.local-override.clean 2>/dev/null || echo "")"

        if [[ "$filter_smudge" != "$expected_smudge" || "$filter_clean" != "$expected_clean" ]]; then
            info "Configuring filter driver..."
            configure_filter_driver "$checkout_root" "$common_git_dir/hooks" scripts \
                || die "Unable to configure filter driver"
            success "Filter driver configured"
        else
            info "Filter driver already configured"
        fi
    fi

    # Read config once for sync_attributes and clear_legacy_skip_worktree
    info "Reading config..."
    local config_entries
    config_entries="$(read_config "$repo_root")"

    # Sync .git/info/attributes from config
    info "Syncing attributes..."
    sync_attributes "$checkout_root" "$config_entries"

    info "Checking for legacy skip-worktree bits..."
    local repaired_count
    repaired_count="$(clear_legacy_skip_worktree "$checkout_root" "$config_entries")"
    if [[ "$repaired_count" -gt 0 ]]; then
        info "Cleared legacy skip-worktree on $repaired_count managed file(s)"
    fi

    # Record that the one-time repair has run so the hot-path hooks skip it. This
    # is the escape hatch: sync-filters always runs the ungated repair above, then
    # (re)writes the marker.
    local repair_marker
    repair_marker="$(skip_worktree_repair_marker "$checkout_root" 2>/dev/null || true)"
    [[ -n "$repair_marker" ]] && : > "$repair_marker"

    # Count filtered files
    local attributes_file
    local filter_count

    attributes_file="$(get_attributes_file_path "$checkout_root")" || die "Unable to resolve git attributes path"
    filter_count="$(count_managed_attribute_lines "$attributes_file")"

    # Register the resolved config set (including any newly created gitignored
    # configs) so hook hot paths can trust the stamp. The stamp lives in the
    # checkout's git dir; the config set resolves against the resolution root.
    write_config_stamp "$checkout_root" "$repo_root"

    success "Synced $filter_count file(s) to filter driver"
}

# Read-only lint of the effective recursive config. Reuses the resolver's
# validate_config (duplicate targets, subtree escapes, traversal, etc.) without
# performing any git operation or mutating state, so it is safe to run in CI.
cmd_validate() {
    local checkout_root
    local repo_root
    checkout_root="$(get_repo_root)" || die "Not in a git repository"
    repo_root="$(get_resolution_root "$checkout_root")"

    # Cache discovery before has_any_config so the check hits the cache instead
    # of paying a throwaway walk first (matches cmd_sync_filters). Without this
    # ordering validate runs two full discovery walks per invocation.
    cache_config_files_readonly "$checkout_root" "$repo_root"
    trap 'clear_config_files_cache' RETURN

    has_any_config "$repo_root" || die "No $CONFIG_FILE_NAME found"

    if validate_config "$repo_root"; then
        local n
        n="$(count_effective_targets "$repo_root")"
        success "Config valid ($n effective target(s))"
        return 0
    fi
    exit 1
}

# Print one doctor check result line: severity label + check name + detail.
# severity is one of pass|warn|fail. Repair/guidance lines are printed by the
# caller as indented "  -> ..." follow-ups.
doctor_line() {
    local severity="$1"
    local label="$2"
    local detail="$3"

    case "$severity" in
        pass) printf '%b[PASS]%b %-14s %s\n' "$GREEN" "$NC" "$label" "$detail" ;;
        warn) printf '%b[WARN]%b %-14s %s\n' "$YELLOW" "$NC" "$label" "$detail" ;;
        fail) printf '%b[FAIL]%b %-14s %s\n' "$RED" "$NC" "$label" "$detail" ;;
    esac
}

# Read-only diagnostics with an opt-in single repair.
#
# doctor runs its OWN small read-only checks over the same primitives cmd_status
# uses (has_any_config, validate_config, get_hooks_dir, filter.local-override.*,
# get_attributes_file_path, read_config, legacy skip-worktree detection). It does
# NOT refactor cmd_status. See plans/021-doctor-design.md for the full catalog,
# exit-code model, and the noted follow-ups.
#
# Exit 0 when no check FAILs (warnings allowed); exit 1 when any check FAILs.
# --fix applies the single proven repair: filter driver missing -> cmd_sync_filters
# (which also re-syncs attributes and clears legacy skip-worktree bits).
cmd_doctor() {
    local fix=false
    local arg=""
    for arg in "$@"; do
        case "$arg" in
            --fix) fix=true ;;
            *) die "Unknown option for doctor: $arg" ;;
        esac
    done

    local checkout_root
    local repo_root
    checkout_root="$(get_repo_root)" || die "Not in a git repository"
    repo_root="$(get_resolution_root "$checkout_root")"

    cache_config_files_readonly "$checkout_root" "$repo_root"
    trap 'clear_config_files_cache' RETURN

    echo "Local Override Doctor"
    echo "====================="
    echo ""

    local fail_count=0
    local warn_count=0
    local pass_count=0

    # Check 1: config present. Without a config nothing else is meaningful, so
    # this is a hard FAIL and we stop early.
    if ! has_any_config "$repo_root"; then
        doctor_line fail "Config" "no $CONFIG_FILE_NAME found"
        echo "  -> Run 'git-local-override init-config' to create one"
        echo ""
        echo "Summary: 0 passed, 0 warnings, 1 failed"
        return 1
    fi

    local config_count=0
    local config_path=""
    while IFS= read -r config_path || [[ -n "$config_path" ]]; do
        [[ -n "$config_path" ]] || continue
        ((config_count++)) || true
    done < <(get_cached_config_files "$repo_root")
    doctor_line pass "Config" "$config_count config file(s) discovered"
    ((pass_count++)) || true

    # Check 2: config valid. validate_config emits errors on stderr; capture and
    # echo them as indented follow-ups on failure.
    local validate_errors=""
    if validate_errors="$(validate_config "$repo_root" 2>&1 1>/dev/null)"; then
        local target_count
        target_count="$(count_effective_targets "$repo_root")"
        doctor_line pass "Config valid" "$target_count effective target(s)"
        ((pass_count++)) || true
    else
        doctor_line fail "Config valid" "invalid configuration"
        local err_line=""
        while IFS= read -r err_line || [[ -n "$err_line" ]]; do
            [[ -n "$err_line" ]] || continue
            echo "  $err_line"
        done <<< "$validate_errors"
        echo "  -> Fix the errors above (see 'git-local-override validate')"
        ((fail_count++)) || true
    fi

    # Check 3: hooks installed (direct or via the pre-commit framework), mirroring
    # cmd_status's detection over the same shared helper.
    local hooks_dir
    hooks_dir="$(get_hooks_dir "$checkout_root")"
    local hooks_state
    hooks_state="$(detect_hooks_installed "$checkout_root" "$hooks_dir")"

    if [[ "$hooks_state" != missing ]]; then
        doctor_line pass "Hooks" "installed"
        ((pass_count++)) || true
    else
        doctor_line warn "Hooks" "not installed"
        echo "  -> Install with 'pre-commit install ...' or scripts/install.sh --cli"
        ((warn_count++)) || true
    fi

    # Check 4: filter driver configured. Healthy = (smudge AND clean) OR process,
    # so a repo installed with GIT_LOCAL_OVERRIDE_FILTER_PROCESS=1 (plan 019) is
    # not false-failed. This is the ONE repair --fix implements.
    local filter_configured=false
    if [[ "$(get_filter_driver_mode "$checkout_root")" != none ]]; then
        filter_configured=true
    fi

    if [[ "$filter_configured" == true ]]; then
        doctor_line pass "Filter driver" "configured"
        ((pass_count++)) || true
    elif [[ "$fix" == true ]]; then
        doctor_line fail "Filter driver" "not configured — repairing via sync-filters"
        echo ""
        # Delegate to the existing tested repair path. cmd_sync_filters configures
        # the filter driver, re-syncs attributes, and clears legacy skip-worktree
        # bits — so this one delegation also resolves checks 5 and 6.
        cmd_sync_filters
        echo ""
        info "Re-run 'git-local-override doctor' to confirm the repair"
        # Repaired: cmd_sync_filters dies on failure, so reaching here means the
        # filter driver is now configured. Do not count it as a failure — the
        # exit code should reflect the post-fix state.
    else
        doctor_line fail "Filter driver" "not configured"
        echo "  -> Run 'git-local-override doctor --fix' (delegates to sync-filters)"
        ((fail_count++)) || true
    fi

    # Checks 5 and 6 inspect state that the check-4 repair also fixes. Skip them
    # after a --fix run reconfigured the filter driver, since sync-filters already
    # re-synced attributes and cleared skip-worktree bits.
    local skip_post_fix_checks=false
    if [[ "$fix" == true && "$filter_configured" == false ]]; then
        skip_post_fix_checks=true
    fi

    if [[ "$skip_post_fix_checks" == false ]]; then
        # Both checks below are repaired by the same cmd_sync_filters delegation;
        # collect one signal and repair once after both have reported.
        local needs_sync_fix=false

        # Check 5: attributes in sync with the effective config.
        local attributes_file
        local filter_count
        local config_target_count
        attributes_file="$(get_attributes_file_path "$checkout_root")" || die "Unable to resolve git attributes path"
        filter_count="$(count_managed_attribute_lines "$attributes_file")"
        config_target_count="$(count_effective_targets "$repo_root")"

        if [[ "$filter_count" -eq "$config_target_count" ]]; then
            doctor_line pass "Attributes" "in sync ($filter_count file(s))"
            ((pass_count++)) || true
        elif [[ "$fix" == true ]]; then
            doctor_line fail "Attributes" "out of sync (config: $config_target_count, filtered: $filter_count) — repairing via sync-filters"
            needs_sync_fix=true
        else
            doctor_line warn "Attributes" "out of sync (config: $config_target_count, filtered: $filter_count)"
            echo "  -> Run 'git-local-override sync-filters' to resync attributes"
            ((warn_count++)) || true
        fi

        # Check 6: legacy skip-worktree bits (read-only detection only).
        local skip_worktree_count=0
        local entry=""
        local seen=""
        local target=""
        local ls_output=""
        while IFS= read -r entry || [[ -n "$entry" ]]; do
            [[ -z "$entry" ]] && continue
            target="${entry%%|*}"
            [[ -n "$target" ]] || continue
            if [[ $'\n'"$seen"$'\n' == *$'\n'"$target"$'\n'* ]]; then
                continue
            fi
            seen="$seen
$target"
            if ! git -C "$checkout_root" ls-files --error-unmatch -- "$target" >/dev/null 2>&1; then
                continue
            fi
            ls_output="$(git -C "$checkout_root" ls-files -v -- "$target" 2>/dev/null || true)"
            if [[ "${ls_output:0:1}" == "S" ]]; then
                ((skip_worktree_count++)) || true
            fi
        done < <(read_config "$repo_root")

        if [[ "$skip_worktree_count" -eq 0 ]]; then
            doctor_line pass "Skip-worktree" "no legacy bits"
            ((pass_count++)) || true
        elif [[ "$fix" == true ]]; then
            doctor_line fail "Skip-worktree" "$skip_worktree_count legacy bit(s) present — repairing via sync-filters"
            needs_sync_fix=true
        else
            doctor_line warn "Skip-worktree" "$skip_worktree_count legacy bit(s) present"
            echo "  -> Run 'git-local-override sync-filters' to clear them"
            ((warn_count++)) || true
        fi

        # Repaired states were not counted as warns/fails, so the exit code
        # reflects the post-fix state (same contract as the check-4 repair).
        # needs_sync_fix is only ever set under --fix, so a plain doctor run
        # never mutates anything.
        if [[ "$needs_sync_fix" == true ]]; then
            echo ""
            cmd_sync_filters
            echo ""
            info "Re-run 'git-local-override doctor' to confirm the repair"
        fi
    fi

    # Check 7: symlinked overrides (read side). Pass when followed via the
    # local opt-in; warn when a symlink is being ignored (silent passthrough
    # in the filters is otherwise hard to diagnose).
    local sym_override=""
    local sym_full_path=""
    while IFS= read -r sym_override || [[ -n "$sym_override" ]]; do
        [[ -n "$sym_override" ]] || continue
        sym_full_path="$repo_root/$sym_override"
        [[ -L "$sym_full_path" ]] || continue

        case "$(classify_symlinked_override "$repo_root" "$sym_override")" in
            followed)
                doctor_line pass "Symlinked override" "$sym_override -> $(readlink "$sym_full_path") (followed)"
                ((pass_count++)) || true
                ;;
            ignored-optout)
                doctor_line warn "Symlinked override" "$sym_override is a symlink and is ignored"
                echo "  -> To follow user-created symlinks: git config --local local-override.followSymlinkedOverrides true"
                ((warn_count++)) || true
                ;;
            tracked-refused)
                doctor_line warn "Symlinked override" "$sym_override is tracked by git — refused"
                echo "  -> Only untracked, user-created symlinks are followed"
                ((warn_count++)) || true
                ;;
            dangling)
                doctor_line warn "Symlinked override" "$sym_override is a dangling symlink — treated as missing"
                ((warn_count++)) || true
                ;;
        esac
    done < <(get_override_files "$repo_root")

    echo ""
    echo "Summary: $pass_count passed, $warn_count warning(s), $fail_count failed"

    if [[ "$fail_count" -gt 0 ]]; then
        return 1
    fi
    return 0
}

# Thin wrapper: git actually runs the hook script
# hooks/local-override-filter-smudge, so the hook is authoritative. Both this
# subcommand and that hook call the shared run_local_override_smudge core in
# the resolver, keeping them byte-identical on stdout.
cmd_filter_smudge() {
    run_local_override_smudge "$@"
}

# Thin wrapper over the shared run_local_override_clean core (see
# cmd_filter_smudge). The core carries the clean filter's trace instrumentation,
# which this subcommand previously lacked.
cmd_filter_clean() {
    run_local_override_clean "$@"
}

cmd_init_config() {
    local repo_root
    repo_root="$(get_repo_root)" || die "Not in a git repository"

    local config_file="$repo_root/$CONFIG_FILE_NAME"

    if [[ -f "$config_file" ]]; then
        info "Config file already exists: $config_file"
        return 0
    fi

    cat > "$config_file" << 'EOF'
# Local Override Configuration
#
# pattern: Required. Used by CLI to generate default override filenames.
#          Example: ".local" means CLAUDE.md -> CLAUDE.local.md
#
# files: List of override entries. Each entry has:
#        - override: The local file that contains your custom content
#        - replaces: List of tracked files this override replaces
#
# One override file can replace multiple tracked files (1:many).

pattern: ".local"
files:
  # Example: CLAUDE.local.md replaces CLAUDE.md
  - override: CLAUDE.local.md
    replaces:
      - CLAUDE.md

  # Example: One file replacing multiple targets
  # - override: AGENTS.local.md
  #   replaces:
  #     - AGENTS.md
  #     - CLAUDE.md
EOF

    success "Created: $config_file"
    echo ""
    echo "Edit this file to configure your overrides."
    echo "The 'pattern:' field is required."
}

cmd__get_active_targets() {
    local checkout_root
    local repo_root
    checkout_root="$(get_repo_root)" || die "Not in a git repository"
    repo_root="$(get_resolution_root "$checkout_root")"

    cache_config_files_readonly "$checkout_root" "$repo_root"
    trap 'clear_config_files_cache' RETURN

    has_any_config "$repo_root" || return 0

    local entry target override
    while IFS= read -r entry || [[ -n "$entry" ]]; do
        [[ -z "$entry" ]] && continue

        target="${entry%%|*}"
        override="${entry#*|}"

        if [[ -f "$repo_root/$override" && -f "$checkout_root/$target" ]]; then
            echo "$target"
        fi
    done < <(read_config "$repo_root")
}

cmd_shell_init() {
    # The shell-init snippet lives in its own data module so this god-file need
    # not embed it as a heredoc. The resolver's locate_support_file owns the
    # dev-or-installed fallback ladder.
    local shell_init_path
    shell_init_path="$(locate_support_file local-override-shell-init.sh)" \
        || die "Unable to locate local-override-shell-init.sh"

    cat "$shell_init_path"
}

cmd_help() {
    cat << 'EOF'
git-local-override - Manage local file overrides

USAGE:
    git-local-override <command> [options]

COMMANDS:
    add <path>              Create a local override file for a tracked file
    remove [-d] <path>      Remove an override (-d to delete override file too)
    list                    List all configured overrides
    status                  Show detailed status (includes filter driver status)
    apply [--all-worktrees] Manually apply all overrides (syncs filters);
                            --all-worktrees refreshes every linked worktree too
    restore [--all-worktrees] Manually restore all originals from git;
                            --all-worktrees restores every linked worktree too
    sync-filters            Sync filter driver with config and clear legacy skip-worktree
    validate                Validate all .local-overrides.yaml files (read-only; CI-friendly)
    doctor [--fix]          Diagnose common issues (read-only); --fix repairs a
                            missing filter driver via sync-filters
    shell-init              Output shell function wrapping git checkout/switch
    filter-smudge <path>    Filter helper: output local override or passthrough
    filter-clean <path>     Filter helper: output index content when input matches the override, else passthrough
    init-config             Create a .local-overrides.yaml template
    version                 Show the CLI version
    help                    Show this help message

EXAMPLES:
    # Initialize config
    git-local-override init-config

    # Create a local override for CLAUDE.md
    git-local-override add CLAUDE.md

    # Edit your local version
    vim CLAUDE.local.md

    # See what's configured
    git-local-override list

    # Manually apply overrides (hooks do this automatically)
    git-local-override apply

    # Refresh every linked worktree after editing an override
    git-local-override apply --all-worktrees

    # Restore originals (hooks do this before commits)
    git-local-override restore

    # Restore originals across the main checkout and every linked worktree
    git-local-override restore --all-worktrees

    # Sync filter driver with config (useful after config changes)
    git-local-override sync-filters

    # Enable shell integration for transparent checkout/switch
    eval "$(git-local-override shell-init)"

ENVIRONMENT VARIABLES:
    GIT_LOCAL_OVERRIDE_DISABLE=1
        Disables filter driver (smudge/clean passthrough)
        Useful for debugging or temporarily disabling overrides

        Example:
            GIT_LOCAL_OVERRIDE_DISABLE=1 git checkout main

    GIT_LOCAL_OVERRIDE_DISABLE_WORKTREE_FALLBACK=1
        Disables the linked-worktree fallback: a worktree without its own
        .local-overrides.yaml no longer inherits the main worktree's overrides
        (config and override files are resolved against the worktree itself)

        Example:
            GIT_LOCAL_OVERRIDE_DISABLE_WORKTREE_FALLBACK=1 git worktree add ../wt

CONFIG FORMAT:
    The .local-overrides.yaml uses override/replaces format:

      pattern: ".local"         # Required: used to generate override names
      files:
        - override: CLAUDE.local.md
          replaces:
            - CLAUDE.md

        # One override can replace multiple files:
        - override: AGENTS.local.md
          replaces:
            - AGENTS.md
            - CLAUDE.md

HOW IT WORKS:
    1. Repository maintainer creates .local-overrides.yaml
    2. Users create override files (e.g., CLAUDE.local.md)
    3. Git hooks automatically:
       - Show local content in working tree
       - Commit original content
       - Restore local content after commits

    With multi-target overrides, one file can replace many:
    - AGENTS.local.md can replace both AGENTS.md and CLAUDE.md
    - When committing, all targets are restored together

INSTALLATION:
    Hooks can be installed via:

    Pre-commit (recommended for teams):
      Add to .pre-commit-config.yaml:
        repos:
          - repo: https://github.com/jonathanabila/git-override
            rev: v0.9.0  # Use latest version
            hooks:
              - id: local-override-pre-commit
              - id: local-override-post-commit
              - id: local-override-post-checkout
              - id: local-override-pre-rebase

      Then run:
        pre-commit install --hook-type pre-commit --hook-type post-commit --hook-type post-checkout --hook-type pre-rebase

    Standalone:
      curl -fsSL https://raw.githubusercontent.com/jonathanabila/git-override/main/scripts/install.sh | bash -s -- --cli
EOF
}

#------------------------------------------------------------------------------
# Main
#------------------------------------------------------------------------------

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        add)            cmd_add "$@" ;;
        remove|rm)      cmd_remove "$@" ;;
        list|ls)        cmd_list "$@" ;;
        status)         cmd_status "$@" ;;
        apply)          cmd_apply "$@" ;;
        restore)        cmd_restore "$@" ;;
        sync-filters)   cmd_sync_filters "$@" ;;
        validate)       cmd_validate "$@" ;;
        doctor)         cmd_doctor "$@" ;;
        shell-init)     cmd_shell_init "$@" ;;
        _get-active-targets) cmd__get_active_targets "$@" ;;
        filter-smudge)  cmd_filter_smudge "$@" ;;
        filter-clean)   cmd_filter_clean "$@" ;;
        init-config)    cmd_init_config "$@" ;;
        version|--version) cmd_version ;;
        help|--help|-h) cmd_help ;;
        *)              die "Unknown command: $cmd. Run 'git-local-override help' for usage." ;;
    esac
}

main "$@"

#!/usr/bin/env bash
#
# local-override-filter-smudge
#
# Git filter smudge script for git-local-override.
# Replaces git blob content with local override content when available.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=local-override-lib.sh
source "$SCRIPT_DIR/local-override-lib.sh"

# Thin wrapper: the smudge logic lives in run_local_override_smudge (shared
# with the CLI `git-local-override filter-smudge` subcommand), defined in the
# resolver sourced via local-override-lib.sh. This wrapper only adds the
# lifecycle trace logging git-invoked hooks emit.
main() {
    local file_path="${1:-}"
    local operation_name="filter-smudge"

    if [[ -n "$file_path" ]]; then
        operation_name="$operation_name $file_path"
    fi

    run_with_trace_logging "$operation_name" run_local_override_smudge "$@"
}

main "$@"

#!/usr/bin/env bash
#
# local-override-pre-rebase
#
# Restores original content before rebase so checkout/detach operations
# inside rebase are not blocked.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=local-override-lib.sh
source "$SCRIPT_DIR/local-override-lib.sh"

main() {
    local repo_root
    local resolution_root
    repo_root="$(get_repo_root)" || return 0

    # Configs resolve against the resolution root (the main checkout for
    # fallback worktrees); index repairs and HEAD restores stay on the
    # checkout root.
    resolution_root="$(get_resolution_root "$repo_root")"

    cache_config_files "$resolution_root"
    trap 'clear_config_files_cache' RETURN

    if ! has_any_config "$resolution_root"; then
        return 0
    fi

    if ! validate_config "$resolution_root"; then
        return 1
    fi

    local config_entries
    config_entries="$(read_config "$resolution_root")"

    # Rebase is a rare path, so it keeps the ungated repair: it always self-heals
    # legacy skip-worktree bits (and clearing them is required to let the rebase's
    # internal checkouts/detach succeed). The one-shot marker gate is applied only
    # to the truly-hot post-checkout and pre-commit paths.
    local repaired_count
    repaired_count="$(clear_legacy_skip_worktree "$repo_root" "$config_entries")"
    if [[ "$repaired_count" -gt 0 ]]; then
        printf 'git-local-override: cleared legacy skip-worktree on %s managed file(s)\n' "$repaired_count" >&2
    fi

    local entry target
    while IFS= read -r entry || [[ -n "$entry" ]]; do
        [[ -z "$entry" ]] && continue
        target="${entry%%|*}"

        # Restore tracked HEAD content in both index and working tree.
        # Updating only the working tree can still leave index/worktree mismatches.
        if git -C "$repo_root" cat-file -e "HEAD:$target" 2>/dev/null; then
            git -C "$repo_root" -c filter.local-override.smudge= checkout -q HEAD -- "$target" 2>/dev/null || true
        fi
    done <<< "$config_entries"

    return 0
}

main "$@"

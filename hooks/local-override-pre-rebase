#!/usr/bin/env bash
#
# local-override-pre-rebase
#
# Clears skip-worktree flags and restores original content before rebase
# so checkout/detach operations inside rebase are not blocked.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=local-override-lib.sh
source "$SCRIPT_DIR/local-override-lib.sh"

main() {
    local repo_root
    repo_root="$(get_repo_root)" || exit 0

    if [[ ! -f "$repo_root/.local-overrides.yaml" ]]; then
        exit 0
    fi

    if ! validate_config "$repo_root"; then
        exit 1
    fi

    local entry target
    while IFS= read -r entry || [[ -n "$entry" ]]; do
        [[ -z "$entry" ]] && continue
        target="${entry%%|*}"

        # Always clear skip-worktree for rebase safety
        git -C "$repo_root" update-index --no-skip-worktree "$target" 2>/dev/null || true

        # Restore tracked HEAD content in both index and working tree.
        # Updating only the working tree can still leave index/worktree mismatches
        # when prior skip-worktree branch switches kept stale index entries.
        if git -C "$repo_root" cat-file -e "HEAD:$target" 2>/dev/null; then
            GIT_LOCAL_OVERRIDE_DISABLE=1 git -C "$repo_root" checkout -q HEAD -- "$target" 2>/dev/null || true
        fi
    done < <(read_config "$repo_root")

    exit 0
}

main "$@"

#!/usr/bin/env bash
#
# local-override-pre-commit
#
# Restores original content for overridden files before commit.
# This ensures commits contain the original tracked content, not local overrides.
#
# This hook reads recursive .local-overrides.yaml files and restores
# originals for any staged files that have local overrides.
#
# IMPORTANT: If ANY target in a group is staged, ALL targets in that group
# are restored. This ensures consistency for multi-target overrides.
#
# Performance target: <100ms for typical commits
#
set -euo pipefail

# Find the directory where this script lives
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source the shared library
# shellcheck source=local-override-lib.sh
source "$SCRIPT_DIR/local-override-lib.sh"

main() {
    local repo_root
    local resolution_root
    local relevant_configs=""
    local relevant_entries=""
    local overrides_to_restore=""
    repo_root="$(get_repo_root)" || return 0

    # Do not restore/re-apply during rebase-internal commits; the rebase
    # bail in post-commit means a restore here would never be undone.
    if is_rebase_in_progress "$repo_root"; then
        return 0
    fi

    # Configs and override files resolve against the resolution root (the main
    # checkout for fallback worktrees); index and working-tree operations stay
    # on the checkout root. No config-discovery cache here: everything below
    # resolves configs by direct path walks, never a global scan.
    resolution_root="$(get_resolution_root "$repo_root")"

    clear_post_commit_state "$repo_root"

    # Get list of staged files. Read NUL-delimited with quotePath off so
    # names holding tabs, quotes, backslashes, or non-ASCII bytes compare
    # literally against config targets instead of arriving C-quoted and never
    # matching (which would leak override content into the commit). Bash
    # variables cannot hold NUL bytes, so the list lives in an array.
    local -a staged_files
    staged_files=()
    local staged_file=""
    while IFS= read -r -d '' staged_file || [[ -n "$staged_file" ]]; do
        [[ -n "$staged_file" ]] || continue
        staged_files+=("$staged_file")
    done < <(git -C "$repo_root" -c core.quotePath=false diff --cached --name-only -z 2>/dev/null || true)

    # Quick exit if nothing staged
    [[ "${#staged_files[@]}" -gt 0 ]] || return 0

    local config_path=""
    for staged_file in "${staged_files[@]}"; do
        config_path="$(find_nearest_config_for_path "$resolution_root" "$staged_file" 2>/dev/null || true)"
        [[ -n "$config_path" ]] || continue

        if [[ $'\n'"$relevant_configs"$'\n' != *$'\n'"$config_path"$'\n'* ]]; then
            relevant_configs="$relevant_configs
$config_path"
        fi
    done

    [[ -n "$relevant_configs" ]] || return 0

    # This commit touches a managed area, so there is config to enforce. Heal
    # a missing filter driver (plan 050) so the very first commit in a fresh
    # pre-commit-framework clone — before any branch checkout has run the
    # post-checkout heal — still leaves a configured driver behind for
    # subsequent staging and path-limited commits.
    maybe_self_heal_filter_driver "$repo_root"

    local config_entry
    while IFS= read -r config_path || [[ -n "$config_path" ]]; do
        [[ -n "$config_path" ]] || continue

        while IFS= read -r config_entry || [[ -n "$config_entry" ]]; do
            [[ -n "$config_entry" ]] || continue
            # Skip parse-error sentinel entries: they are diagnostics, not
            # targets; validate_config is the gate that surfaces them.
            [[ "${config_entry%%|*}" == "$LOCAL_OVERRIDE_PARSE_ERROR_SENTINEL" ]] && continue
            relevant_entries="$relevant_entries
$config_entry"
        done < <(read_config_entries_for_file "$resolution_root" "$config_path")
    done <<< "$relevant_configs"

    [[ -n "$relevant_entries" ]] || return 0

    local repaired_count
    repaired_count="$(clear_legacy_skip_worktree_once "$repo_root" "$relevant_entries")"
    if [[ "$repaired_count" -gt 0 ]]; then
        printf 'git-local-override: cleared legacy skip-worktree on %s managed file(s)\n' "$repaired_count" >&2
    fi

    # During an in-progress merge or cherry-pick, HEAD is still "ours" (the
    # pre-merge tip), so the HEAD-restore below would silently overwrite a
    # genuine merge/cherry-pick resolution (or a --no-commit change) staged in
    # the index. Skip the restore so the resolution survives into the commit —
    # BUT backstop the unmerged-index leak first: while a path is unmerged,
    # `git show :path` fails, so the clean filter passes working-tree bytes
    # through during `git add`. The smudge filter also serves override content
    # for the conflicted file, so a blind `git add` of the unedited file stages
    # override bytes verbatim. Refuse to commit any staged managed target whose
    # staged blob is byte-identical to its override (file-based cmp, never
    # $(...) — command substitution strips trailing newlines / cannot carry
    # NUL). A genuine resolution differs from the override and passes through.
    # No reapply state is written: nothing was restored, so there is nothing
    # for post-commit to undo (same shape as the rebase bail above); the
    # override remains a .local file and post-checkout/apply/smudge re-serve it.
    if is_merge_or_cherry_pick_in_progress "$repo_root"; then
        local leak_entry=""
        leak_entry="$(precommit_find_merge_leak "$repo_root" "$resolution_root" \
            "$relevant_entries" "${staged_files[@]}" || true)"
        if [[ -n "$leak_entry" ]]; then
            printf 'git-local-override: refusing to commit managed target %s during a merge/cherry-pick: its staged content is byte-identical to the local override %s. The conflicted file likely still held override content when it was added. Write the intended resolution into %s, `git add` it, then retry the commit.\n' \
                "${leak_entry%%|*}" "${leak_entry#*|}" "${leak_entry%%|*}" >&2
            return 1
        fi

        return 0
    fi

    # First pass: the resolver's grouped-restore decider picks which override
    # files have staged targets; ALL targets of each are restored below.
    overrides_to_restore="$(precommit_plan_restores "$resolution_root" \
        "$relevant_entries" "${staged_files[@]}")"

    # Quick exit if no overrides need restoring
    [[ -z "$overrides_to_restore" ]] && return 0

    # Second pass: for each override file to restore, restore ALL its targets
    # (the Group expansion is the resolver's targets_for_override_in_entries).
    local override_file
    while IFS= read -r override_file || [[ -n "$override_file" ]]; do
        [[ -z "$override_file" ]] && continue

        local target_file restore_status
        while IFS= read -r target_file || [[ -n "$target_file" ]]; do
            [[ -z "$target_file" ]] && continue

            # Restore original content (working tree + index) through the
            # shared front door: it owns the HEAD-existence guard, the
            # symlink gate, and mode-proof filter suppression.
            restore_status=0
            restore_target_to_head "$repo_root" "$target_file" full loud \
                || restore_status=$?

            case "$restore_status" in
                0|2)
                    # Restored, or refused with the message already printed
                    # (the refused target is skipped, matching the old gate).
                    ;;
                1)
                    # Absent from HEAD: nothing to restore from. The resolver
                    # decider refuses the commit when the staged blob of the
                    # new target is byte-identical to its override; genuine
                    # canonical content is committed as-is.
                    if precommit_new_target_leaks "$repo_root" "$target_file" \
                        "$resolution_root/$override_file"; then
                        printf 'git-local-override: refusing to commit new managed target %s: it holds local override content and has no tracked canonical version. Provide canonical content (git add the intended tracked file) before committing, or remove it from .local-overrides.yaml.\n' "$target_file" >&2
                        return 1
                    fi
                    ;;
                *)
                    # Restore failed mid-commit: fail closed. Continuing would
                    # commit staged override content for this target.
                    printf 'git-local-override: failed to restore %s from HEAD; aborting commit\n' "$target_file" >&2
                    return 1
                    ;;
            esac
        done < <(targets_for_override_in_entries "$override_file" "$relevant_entries")
    done <<< "$overrides_to_restore"

    # Record what was restored so post-commit (or a post-checkout heal after
    # an aborted commit) re-applies the overrides. The writer owns the record
    # format and the resolution-root anchoring.
    record_reapply_state "$repo_root" "$resolution_root" \
        "$overrides_to_restore" "$relevant_entries"

    return 0
}

main "$@"

#!/usr/bin/env bash
#
# local-override-filter-clean
#
# Git filter clean script for git-local-override.
# Restores original git content when a local override is active.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=local-override-lib.sh
source "$SCRIPT_DIR/local-override-lib.sh"

# Thin wrapper: the clean logic (including trace instrumentation) lives in
# run_local_override_clean (shared with the CLI `git-local-override
# filter-clean` subcommand), defined in the resolver sourced via
# local-override-lib.sh.
main() {
    run_local_override_clean "$@"
}

main "$@"

#!/usr/bin/env bash
#
# local-override-filter-clean
#
# Git filter clean script for git-local-override.
# Restores original git content when a local override is active.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=local-override-lib.sh
source "$SCRIPT_DIR/local-override-lib.sh"

main() {
    local file_path="${1:-}"
    local stdin_tmp=""

    stdin_tmp="$(mktemp "${TMPDIR:-/tmp}/local-override-clean.XXXXXX")"
    cat > "$stdin_tmp"

    if [[ "${GIT_LOCAL_OVERRIDE_DISABLE:-0}" == "1" ]]; then
        cat "$stdin_tmp"
        rm -f "$stdin_tmp"
        return 0
    fi

    local repo_root
    repo_root="$(get_repo_root)" || {
        cat "$stdin_tmp"
        rm -f "$stdin_tmp"
        return 0
    }

    if ! has_any_config "$repo_root"; then
        cat "$stdin_tmp"
        rm -f "$stdin_tmp"
        return 0
    fi

    local override_file
    override_file="$(get_override_for_file "$repo_root" "$file_path")"

    if [[ -n "$override_file" && -f "$repo_root/$override_file" ]]; then
        # Only transform when incoming content is exactly the local override.
        # If caller already provided original/tracked content (e.g., pre-commit
        # restored file), passthrough avoids clobbering intended staged content.
        if cmp -s "$stdin_tmp" "$repo_root/$override_file"; then
            if git -C "$repo_root" show ":$file_path" >/dev/null 2>&1; then
                git -C "$repo_root" show ":$file_path" 2>/dev/null || cat "$stdin_tmp"
                rm -f "$stdin_tmp"
                return 0
            fi
        fi
    fi

    cat "$stdin_tmp"
    rm -f "$stdin_tmp"
}

main "$@"

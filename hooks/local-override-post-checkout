#!/usr/bin/env bash
#
# local-override-post-checkout
#
# Applies local overrides to the working tree after checkout operations.
# Called by git after: checkout, switch, clone, pull (with checkout)
#
# This hook reads recursive .local-overrides.yaml files and applies
# effective override files to their target files.
#
# Arguments (from git):
#   $1 - Previous HEAD ref
#   $2 - New HEAD ref
#   $3 - Flag: 1 if checkout was a branch checkout, 0 if file checkout
#
# Performance target: <50ms for 10 overrides
#
set -euo pipefail

# Find the directory where this script lives
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source the shared library
# shellcheck source=local-override-lib.sh
source "$SCRIPT_DIR/local-override-lib.sh"

checkout_config_change_state() {
    local repo_root="$1"
    local previous_head="$2"
    local new_head="$3"
    local diff_output=""

    [[ -n "$previous_head" && -n "$new_head" ]] || {
        printf 'unknown\n'
        return 0
    }

    if ! git -C "$repo_root" rev-parse --verify "$previous_head^{commit}" >/dev/null 2>&1; then
        printf 'unknown\n'
        return 0
    fi

    if ! git -C "$repo_root" rev-parse --verify "$new_head^{commit}" >/dev/null 2>&1; then
        printf 'unknown\n'
        return 0
    fi

    diff_output="$(git -C "$repo_root" diff --name-only "$previous_head" "$new_head" -- "$CONFIG_FILE_NAME" "*/$CONFIG_FILE_NAME" 2>/dev/null || true)"
    if [[ -n "$diff_output" ]]; then
        printf 'changed\n'
    else
        printf 'unchanged\n'
    fi
}

resolve_post_checkout_entries_fast() {
    local repo_root="$1"
    local resolution_root="$2"
    local config_entries=""

    # The caller has already confirmed there is no tracked-config HEAD diff and
    # populated the hot discovery cache. A tracked HEAD diff cannot see edits to
    # gitignored/untracked configs, so compare the on-disk config set (the hot
    # cache) against the stamp recorded by the last full resolution and fall
    # back to full discovery on any drift. Equality here means exactly "no
    # config drift is visible without an ignored-tree walk".
    if ! config_stamp_matches "$repo_root" "$resolution_root"; then
        local_override_trace_log "post-checkout" "config-stamp drift; falling back to full discovery"
        return 1
    fi

    config_entries="$(read_config_entries_from_attributes "$resolution_root" 2>/dev/null)" || return 1

    local_override_trace_log "post-checkout" "fast-path config=unchanged managed_targets=$(count_list_entries "$config_entries")"
    printf '%s' "$config_entries"
}

run_post_checkout() {
    local _previous_head="${1:-}"
    local _new_head="${2:-}"
    local config_entries=""
    local using_fast_path=false

    local repo_root
    local resolution_root
    repo_root="$(get_repo_root)" || return 0

    # Do not re-apply overrides during rebase internal checkouts. Checked
    # before resolving the resolution root: that resolution runs config
    # discovery in fallback worktrees, and rebases fire this hook per commit.
    if is_rebase_in_progress "$repo_root"; then
        return 0
    fi

    # Configs and override files resolve against the resolution root (the main
    # checkout for fallback worktrees); target writes and index repairs stay
    # on the checkout root.
    resolution_root="$(get_resolution_root "$repo_root")"
    trap 'clear_config_files_cache' RETURN

    # A tracked-config HEAD diff is the only signal the hot path acts on: when
    # the tracked configs are unchanged, discovery can skip the ignored-tree
    # walk and trust the stamp for known gitignored configs.
    local config_change_state
    config_change_state="$(checkout_config_change_state "$repo_root" "$_previous_head" "$_new_head")"

    if [[ "$config_change_state" == "unchanged" ]]; then
        # Hot discovery: one non-ignored-tree walk plus the stamped gitignored
        # configs. A brand-new gitignored config is registered by
        # sync-filters/apply (full discovery), not here.
        cache_config_files "$resolution_root" hot "$(get_stamped_config_paths "$repo_root")"
        if config_entries="$(resolve_post_checkout_entries_fast "$repo_root" "$resolution_root")"; then
            using_fast_path=true
        fi
    fi

    if [[ "$using_fast_path" != true ]]; then
        # Slow path: re-run full discovery (directly-ignored configs included)
        # and re-sync attributes + stamp so the next hot path can trust them.
        clear_config_files_cache
        cache_config_files "$resolution_root"

        if ! has_any_config "$resolution_root"; then
            return 0
        fi

        if ! validate_config "$resolution_root"; then
            return 1
        fi

        config_entries="$(read_config "$resolution_root")"

        if ! sync_attributes_entries "$repo_root" "$config_entries"; then
            return 1
        fi

        # The attributes now reflect this resolution; record what it was
        # built from so future fast paths can detect drift.
        write_config_stamp "$repo_root" "$resolution_root"
    fi

    if [[ "$using_fast_path" == true && -z "$config_entries" ]]; then
        return 0
    fi

    local repaired_count
    repaired_count="$(clear_legacy_skip_worktree_once "$repo_root" "$config_entries")"
    if [[ "$repaired_count" -gt 0 ]]; then
        printf 'git-local-override: cleared legacy skip-worktree on %s managed file(s)\n' "$repaired_count" >&2
    fi

    # Apply each override
    local entry target override
    while IFS= read -r entry || [[ -n "$entry" ]]; do
        [[ -z "$entry" ]] && continue

        # Parse entry: "target|override"
        target="${entry%%|*}"
        override="${entry#*|}"

        local full_target="$repo_root/$target"
        local full_override="$resolution_root/$override"

        # Check if both target and override files exist
        if [[ -f "$full_override" && -f "$full_target" ]]; then
            if ! path_is_symlink_safe "$repo_root" "$target" \
               || ! path_is_symlink_safe "$resolution_root" "$override"; then
                printf 'git-local-override: refusing symlinked path for %s\n' "$target" >&2
                continue
            fi
            # Apply override: copy override content to target file
            cp "$full_override" "$full_target"
        fi
    done <<< "$config_entries"

    # Heal an aborted commit: pre-commit restored originals and left a reapply
    # state file, but post-commit never ran. Re-apply from that leftover state
    # now (guarded above by the rebase bail) and clear it.
    reapply_post_commit_state "$repo_root"

    return 0
}

main() {
    # Only apply on branch checkouts (3rd arg = 1), not file checkouts (3rd arg = 0)
    # This allows `git checkout HEAD -- file` to work for restoring originals
    local is_branch_checkout="${3:-1}"
    if [[ "$is_branch_checkout" == "0" ]]; then
        return 0
    fi

    run_with_lifecycle_logging "post-checkout" run_post_checkout "$@"
}

main "$@"

# Dockerfile for bash compatibility testing
#
# This uses Alpine's bash but runs tests in a way that helps catch
# bash 4+ features that would break on macOS.
#
# The real bash 3.2 compatibility testing happens on macOS in GitHub Actions.
#
FROM alpine:3.19

# Install runtime dependencies. Alpine's fd package installs the binary as `fd`
# directly (no fdfind rename), so the resolver's fd discovery strategy is
# exercised in the bash-compat image too.
RUN apk add --no-cache \
    bash \
    git \
    curl \
    fd

# Configure git for testing
RUN git config --global user.email "test@example.com" \
    && git config --global user.name "Test User" \
    && git config --global init.defaultBranch main

# Create test user
RUN adduser -D -s /bin/bash testuser
USER testuser
WORKDIR /home/testuser

# Copy project files
COPY --chown=testuser:testuser . /home/testuser/project

WORKDIR /home/testuser/project

# Rebuild the copied source as a standalone git repo so Docker runs from
# either a normal clone or a host worktree use a portable project tree.
RUN rm -rf .git \
    && git init -q \
    && git config user.email "test@example.com" \
    && git config user.name "Test User" \
    && git add . \
    && git commit -q -m "Test source snapshot"

# Set up PATH
ENV PATH="/home/testuser/.local/bin:${PATH}"

# Entry point - run without pre-commit tests (no pre-commit in alpine)
ENTRYPOINT ["./tests/docker/entrypoint.sh"]
CMD ["unit", "install", "gitops", "worktree"]
